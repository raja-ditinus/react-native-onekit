{
  "name": "react-native-onekit",
  "version": "0.1.0",
  "description": "A modern React Native UI component library with customizable components and themes.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-onekit-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "typecheck": "tsc",
    "test": "jest",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "example": "yarn workspace react-native-onekit-example",
    "web": "vite",
    "build:web": "vite build",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "react-native",
    "react-native-ui",
    "ui-kit",
    "components",
    "design-system",
    "typescript",
    "mobile",
    "ios",
    "android",
    "cross-platform"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raja-ditinus/react-native-onekit.git"
  },
  "author": "raja-ditinus <raja@ditinustechnology.com> (https://github.com/raja-ditinus)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/raja-ditinus/react-native-onekit/issues"
  },
  "homepage": "https://github.com/raja-ditinus/react-native-onekit#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "<%- project.sourceCondition -%>"
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "ts",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "version": "0.63.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "yalcSig": "5c93594fa3dae136da1a7a544d81ec49"
}
